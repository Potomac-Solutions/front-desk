{
  "name": "front-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appointments, forms, an events calendar and giving, for offices and community groups. A Potomac Solutions platform, built on the kit and Zubra.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "design-check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@potomac-solutions/kit": "github:Potomac-Solutions/potomac-kit#82ebfd88904814bf45f984d84f9f5d1adce67ebe",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
